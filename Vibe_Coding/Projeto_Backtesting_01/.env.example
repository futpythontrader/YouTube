# ============================================================
# BacktestBet — Environment Variables
# ============================================================
# Copie este arquivo para .env e preencha os valores.
# Execute: python generate_env.py (gera SECRET_KEY automaticamente)
# ============================================================

# === Django ===
# SECRET_KEY: chave secreta do Django (gere com generate_env.py)
SECRET_KEY=change-me
# DEBUG: nunca ative em produção
DEBUG=False
# ALLOWED_HOSTS: domínios permitidos (separados por vírgula)
ALLOWED_HOSTS=backtestbet.com,www.backtestbet.com
# Django settings module usado pelo Docker
DJANGO_SETTINGS_MODULE=config.settings.production
# Redirecionar HTTP → HTTPS (ativar com proxy reverso)
SECURE_SSL_REDIRECT=True

# === Banco de Dados (PostgreSQL na VPS) ===
# Formato: postgres://USER:PASS@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=postgres://backtestbet_user:senha_segura@seu-vps.com:5432/backtestbet_prod?sslmode=require

# === Email (SMTP Gmail com App Password) ===
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seuemail@gmail.com
# App Password do Gmail (16 caracteres, sem espaços)
EMAIL_HOST_PASSWORD=aaaaaaaabbbbbbbb
DEFAULT_FROM_EMAIL=BacktestBet <seuemail@gmail.com>

# === Gunicorn ===
# WEB_CONCURRENCY: número de workers (padrão: 3)
WEB_CONCURRENCY=3
# WEB_THREADS: threads por worker (padrão: 2)
WEB_THREADS=2
# PORT: porta do servidor (padrão: 8000)
PORT=8000

# === API FutPythonTrader ===
# Token de acesso à API de dados esportivos
FUTPYTHONTRADER_TOKEN=seu_token_aqui
# URL base da API
FUTPYTHONTRADER_BASE_URL=https://api.futpythontrader.com/api/dados

# === Celery (futuro — não ativo no MVP) ===
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
